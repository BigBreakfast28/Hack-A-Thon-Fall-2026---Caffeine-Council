# Reference only. Export these in your shell or set them in your host's secret manager.
# Never commit real values.
GEMINI_API_KEY=            # paid-tier key, server side only
GEMINI_MODEL=gemini-3.8-flash
PORT=8080                  # plain ws://; terminate TLS in front of it
ALLOWED_ORIGIN=            # exact origin of the front end, e.g. https://muse.example.com
MAGIC_TICKET_SECRET=       # signs Magic Tickets; mint with: node mint-ticket.js 24
SOLANA_RPC_URL=            # JSON-RPC node used for wallet balance checks (optional)
WALLET_MIN_LAMPORTS=1      # minimum balance for the wallet gate
ACCESS_MODE=               # 'open' skips access checks for local development only; ignored when NODE_ENV=production
